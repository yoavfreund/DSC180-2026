;; macOS sandbox profile for agent-written learner binaries (make, train, predict).
;; Used as: sandbox-exec -D BUILD=... -D INPUT=... -f learner.sb CMD
;;   BUILD  the snapshot of learner/ being built and run (read + write)
;;   INPUT  the one data directory this step may read (read only)
;; Nothing under /Users (every home folder, plus /Users/Shared), temp dirs or
;; external volumes is readable except those two, and there is no network.
;; Later rules override earlier ones.
(version 1)
(allow default)
(deny network*)
(deny file-read* file-write*
    (subpath "/Users")
    (subpath "/private/tmp")
    (subpath "/private/var/folders")
    (subpath "/Volumes"))
(allow file-read* file-write* (subpath (param "BUILD")))
(allow file-read* (subpath (param "INPUT")))
